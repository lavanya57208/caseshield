# ---------------------------------------------------------------------------
# Case Shield - server environment configuration
# ---------------------------------------------------------------------------
# This prototype runs on an embedded SQLite database by default so it works
# with zero configuration. The schema is written to mirror the production
# PostgreSQL schema used by the real backend (see /backend and /prisma at the
# repository root), so it is a runnable stand-in, not the production driver.

PORT=4000
JWT_SECRET=change-this-in-production-to-a-long-random-string
NODE_ENV=development
DB_DRIVER=sqlite

# --- AI provider (optional) --------------------------------------------------
# Leave blank to run with AI features honestly disabled ("AI service not
# configured"). Case Shield never fakes an AI response.
AI_PROVIDER=
AI_API_KEY=


# --- Development storage ------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./backend/storage-dev