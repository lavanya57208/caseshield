# ==============================================================================
# CASE SHIELD — Environment Configuration
# Copy to .env and fill in values. Never commit .env. See docs/security-architecture.md.
#
# This repository-root .env is the single source of truth for local dev config.
# - The backend app (backend/src/config/env.ts) loads it directly by resolved
#   path, so `npm run dev:backend` works from any cwd.
# - `npm run prisma:generate` / `prisma:migrate` / `prisma:seed` must be run
#   from the repository root: the Prisma CLI's automatic .env discovery only
#   checks the current working directory (and the schema's own directory),
#   so running from repo root is what lets it find this file.
# ==============================================================================

# --- Runtime mode -------------------------------------------------------------
# "development" selects local adapters (filesystem storage, demo identity,
# mock AI, dev key provider). "production" selects Google Cloud adapters and
# requires every GOOGLE_CLOUD_* / IDENTITY_PLATFORM_* value below.
CASE_SHIELD_ENV=development
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database -------------------------------------------------------------
# Local dev default matches the local PostgreSQL cluster created for this
# prototype. In production this points at Cloud SQL (via the Cloud SQL Auth
# Proxy or a private IP connection).
DATABASE_URL=postgresql://caseshield:caseshield_dev_pw@localhost:5432/case_shield_dev

# --- Auth / sessions --------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-development-only-secret
JWT_EXPIRES_IN=8h

# --- Development storage (used only when CASE_SHIELD_ENV=development) -----
LOCAL_STORAGE_DIR=./backend/storage-dev
# Optional: force the storage adapter ("local" | "gcs"). Defaults from
# CASE_SHIELD_ENV (development -> local). Local needs no cloud credentials.
STORAGE_PROVIDER=

# --- PII protection (Phase 2) -------------------------------------------------
# Only "deterministic" is implemented; an AI/NLP provider is future work.
PII_PROVIDER=deterministic
# HMAC key for PII fingerprints (raw values are never stored). If blank, a key
# is derived from JWT_SECRET. Set a dedicated long random value in production.
PII_FINGERPRINT_SECRET=

# --- Tests ------------------------------------------------------------------
# Optional. Defaults to DATABASE_URL with "_test" appended to the DB name.
# Integration tests refuse any database whose name does not end in "_test".
TEST_DATABASE_URL=

# --- Google Cloud (production adapters — leave blank in development) ------
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_REGION=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_KMS_KEY_RING=
GOOGLE_CLOUD_KMS_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Identity Platform (production) ----------------------------------------
IDENTITY_PLATFORM_PROJECT_ID=
IDENTITY_PLATFORM_API_KEY=

# --- Secret Manager (production) --------------------------------------------
SECRET_MANAGER_CONFIG=

# --- AI provider -------------------------------------------------------------
# "mock" (development default) performs no network calls.
# "vertex" / "document-ai" require the Google Cloud values above.
AI_PROVIDER=mock
AI_API_KEY=

# --- Phase 4: OCR / document intelligence (docs/document-processing.md) ------
# OCR provider: "mock" reads embedded demo fixture layers only (no real OCR);
# "document-ai" calls Google Document AI. Blank = follow AI_PROVIDER.
OCR_PROVIDER=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
# Vertex AI models used when AI_PROVIDER=vertex.
VERTEX_AI_MODEL=gemini-2.5-flash
VERTEX_AI_EMBEDDING_MODEL=text-embedding-005
# "auto" processes uploads in the background; "manual" only queues them.
DOCUMENT_PROCESSING_MODE=auto

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
